# ─────────────────────────────────────────────────────────────
#  rag-chatbot environment
#  Copy this file to `.env.local` and fill in what you want to use.
#  NOTHING here is required to run the demo — see README.md.
# ─────────────────────────────────────────────────────────────

# --- LLM provider (any OpenAI-compatible endpoint) ---
# Leave LLM_API_KEY empty to run in DEMO MODE (bundled deterministic engine, zero cost).
# Set LLM_API_BASE to use a local model (e.g. LM Studio: http://localhost:1234/v1)
# or a hosted provider (https://api.openai.com/v1).
LLM_API_BASE=http://localhost:1234/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Embeddings (OpenAI-compatible) ---
# Leave empty to run in DEMO MODE (keyword hashing, no API call).
# The vector column in supabase/migrations/001_init.sql is vector(1536), which is
# text-embedding-3-small. A different model needs EMBEDDING_DIM + that column changed.
EMBEDDING_API_BASE=http://localhost:1234/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Vector store ---
# Leave empty to run in DEMO MODE (in-process document store, no database).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin panel ---
# Leave empty in the demo: /admin is then open, which is fine locally.
# Set it before this is reachable from the internet — /admin and the admin APIs
# (ingest, delete, logs) are then gated behind this password.
ADMIN_PASSWORD=

# ─── Guardrail tuning (all optional, these are the defaults) ───
# similarity is the retrieval-score floor; coverage is the share of the question's
# content words the top chunk must actually contain. Coverage is what stops an
# unrelated question from being answered.
GUARDRAIL_SIMILARITY_THRESHOLD=0.5
GUARDRAIL_MIN_COVERAGE=0.5
GUARDRAIL_MAX_TOKENS=320
GUARDRAIL_TOP_K=5
# Documents at or above this ratio of instruction-shaped lines are quarantined.
GUARDRAIL_QUARANTINE_THRESHOLD=0.15
# Comma-separated. Blocked always refuses; required (if set) is an allowlist.
GUARDRAIL_BLOCKED_TOPICS=
GUARDRAIL_REQUIRED_TOPICS=

# ─── Chunking ───
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
